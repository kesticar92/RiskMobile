rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdvisor() {
      return isSignedIn()
        && exists(userDocPath())
        && get(userDocPath()).data.role == 'advisor';
    }

    function ownsCase() {
      return isSignedIn() && resource.data.clientId == request.auth.uid;
    }

    function createsOwnCase() {
      return isSignedIn() && request.resource.data.clientId == request.auth.uid;
    }

    function canAccessCaseData(caseId) {
      return isSignedIn()
        && (
          get(/databases/$(database)/documents/cases/$(caseId)).data.clientId == request.auth.uid
          || isAdvisor()
        );
    }

    // Perfil — lectura cruzada (asesor↔cliente) y edición solo del dueño
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update, delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Casos crediticios
    match /cases/{caseId} {
      allow read: if isSignedIn() && (ownsCase() || isAdvisor());
      allow create: if isSignedIn() && createsOwnCase();
      allow update: if isSignedIn() && (ownsCase() || isAdvisor());
      allow delete: if isSignedIn() && ownsCase();

      match /caseStatusHistory/{historyId} {
        allow read: if canAccessCaseData(caseId);
        allow create: if isSignedIn() && isAdvisor();
      }
    }

    // Documentos cargados por el cliente; el asesor actualiza estado
    match /documents/{docId} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdvisor());
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && isAdvisor();
      allow delete: if false;
    }

    // Notificaciones in-app
    match /notifications/{notifId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // Chat: messages/{chatId}/chat/{msgId}
    match /messages/{chatId} {
      match /chat/{msgId} {
        allow read, create: if isSignedIn();
        allow update, delete: if false;
      }
    }

    // Comisiones (panel asesor)
    match /commissions/{commId} {
      allow read: if isSignedIn() && resource.data.advisorId == request.auth.uid;
      allow create: if isSignedIn() && isAdvisor();
      allow update, delete: if false;
    }

    match /payments/{paymentId} {
      allow read, write: if isSignedIn();
    }
  }
}
